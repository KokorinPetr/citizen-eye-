ENVIRONMENT=local
DATABASE_URL=postgresql+asyncpg://civic_eye:civic_eye@localhost:5432/civic_eye
TEST_DATABASE_URL=postgresql+asyncpg://civic_eye:civic_eye@localhost:5432/civic_eye_test
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Generate with: uv run python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# AI provider: deepseek | openai | fake (fake = no network, fixed answer; used by tests)
AI_PROVIDER=deepseek
# DeepSeek models: deepseek-flash (fast, cheap) or deepseek-v4-pro
AI_MODEL=deepseek-flash
# Paste your DeepSeek key here (DEEPSEEK_API_KEY=... also works)
AI_API_KEY=
