# Production settings. On the server: cp deploy/.env.prod.example .env.prod  (then edit)
# .env.prod is git-ignored. Never commit real values.

# Your subdomain, without https:// (Cloudflare DNS: A record → server IP, proxied)
DOMAIN=civiceye.example.com

# Database password: long and random. Generate: openssl rand -base64 32 | tr -d '=+/'
POSTGRES_PASSWORD=change-me

# Login tokens. Generate: openssl rand -base64 48 | tr -d '=+/'
JWT_SECRET_KEY=change-me

# AI (DeepSeek). Empty key = reports still work, AI parsing falls back.
AI_PROVIDER=deepseek
AI_MODEL=deepseek-flash
AI_API_KEY=

# Optional
# ACCESS_TOKEN_TTL_MINUTES=15
# REFRESH_TOKEN_TTL_DAYS=7
# HTTP_PORT=80
# HTTPS_PORT=443
# CERTS_DIR=./deploy/certs
